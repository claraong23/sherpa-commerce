# =============================================================================
# VISA AGENTIC COMMERCE — environment
# Copy to `.env.local` and fill in only what you have.
# The app runs end-to-end with NOTHING filled in (DEMO_MODE=true).
# Anything NOT prefixed with NEXT_PUBLIC_ is server-only and never reaches the
# browser bundle.
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=development
# true  -> seeded data, mock Visa, demo Shopify mirror, deterministic agents when
#          no OpenAI key. Every route renders.
# false -> integrations are required; missing credentials surface as errors.
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OpenAI (server-only) ----------------------------------------------------
# Activates: LLM intent extraction, onboarding conversation, merchant SKU
# strategy selection, storefront chat, recommendation prose, rule extraction.
# Without it the app falls back to deterministic NLU (still fully functional).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Realtime voice onboarding (browser WebRTC). Needs OPENAI_API_KEY.
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17

# --- Supabase ----------------------------------------------------------------
# If NEXT_PUBLIC_SUPABASE_URL *and* SUPABASE_SERVICE_ROLE_KEY are set the app
# uses Postgres. Otherwise it uses the in-process seeded store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Shopify (server-only) ---------------------------------------------------
# SHOPIFY_ADMIN_ACCESS_TOKEN + SHOPIFY_DEMO_STORE_DOMAIN activate the real
# GraphQL Admin adapter (catalogue sync, live inventory, orderCreate).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_DEMO_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_SCOPES=read_products,read_inventory,write_orders
# Which seeded merchant slug the Shopify store maps to.
SHOPIFY_MERCHANT_SLUG=tan-computers

# --- Visa Acceptance (server-only) -------------------------------------------
# mock    -> simulated authorization, same request/response model. Default.
# sandbox -> real HTTP call to Visa Acceptance sandbox using HTTP Signature.
VISA_ACCEPTANCE_MODE=mock
VISA_ACCEPTANCE_BASE_URL=https://apitest.visaacceptance.com
VISA_ACCEPTANCE_MERCHANT_ID=
VISA_ACCEPTANCE_KEY_ID=
VISA_ACCEPTANCE_SECRET_KEY=
# Sandbox-only test instrument used server-side. Never logged, never sent to an
# LLM, never stored. Visa sandbox test PAN.
VISA_ACCEPTANCE_TEST_PAN=4111111111111111
VISA_ACCEPTANCE_TEST_EXP_MONTH=12
VISA_ACCEPTANCE_TEST_EXP_YEAR=2031

# --- TAP-style agent signing (server-only) -----------------------------------
# Generate with: pnpm tap:generate-keys
# Ed25519 keys, base64 (raw 32-byte seed / raw 32-byte public key).
# If absent, an ephemeral in-memory keypair is generated at boot.
TAP_PRIVATE_KEY=
TAP_PUBLIC_KEY=
TAP_KEY_ID=customer-agent-01

# --- Feature flags -----------------------------------------------------------
ENABLE_REALTIME_VOICE=true
ENABLE_WEBAUTHN=true
ENABLE_SHOPIFY_SYNC=true
ENABLE_SHOPIFY_ORDER_CREATE=true
ENABLE_LLM=true
# Milliseconds of stagger between merchant agents so the offer round is legible
# in the visualization. Set to 0 for maximum speed.
AGENT_STAGGER_MS=420
